{
  "name": "JournalTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          }
        }
      },
      "description": "Journal prompts for this template"
    },
    "strategy": {
      "type": "string",
      "description": "Associated strategy name"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}
